    Memory.write_i32(buf + 1440, 47)
    Memory.write_i32(buf + 1444, 45)
    Memory.write_i32(buf + 1448, 46)
    Memory.write_i32(buf + 1452, 43)
    Memory.write_i32(buf + 1456, 44)
    Memory.write_i32(buf + 1460, 327745)
    Memory.write_i32(buf + 1464, 48)
    Memory.write_i32(buf + 1468, 49)
    Memory.write_i32(buf + 1472, 36)
    Memory.write_i32(buf + 1476, 27)
    Memory.write_i32(buf + 1480, 196670)
    Memory.write_i32(buf + 1484, 49)
    Memory.write_i32(buf + 1488, 47)
    Memory.write_i32(buf + 1492, 65789)
    Memory.write_i32(buf + 1496, 65592)

fun _frog_init_temporal_vert_shader(buf: i64) -> void:
    _frog_init_temporal_vert_shader_p0(buf)
    _frog_init_temporal_vert_shader_p1(buf)
    _frog_init_temporal_vert_shader_p2(buf)
    _frog_init_temporal_vert_shader_p3(buf)

fun get_temporal_vert_shader() -> EmbeddedShader:
    shader: EmbeddedShader = EmbeddedShader()
    buf: i64 = Memory.malloc_zeroed(1500)
    if buf == 0:
        return shader
    _frog_init_temporal_vert_shader(buf)
    shader.data = buf
    shader.size = 1500
    return shader
# <<< EMBED temporal_vert END
