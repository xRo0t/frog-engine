fun _frog_init_hzb_shader(buf: i64) -> void:
    _frog_init_hzb_shader_p0(buf)
    _frog_init_hzb_shader_p1(buf)

fun get_hzb_compute_shader() -> EmbeddedShader:
    shader: EmbeddedShader = EmbeddedShader()
    buf: i64 = Memory.malloc_zeroed(3804)
    if buf == 0:
        return shader
    _frog_init_hzb_shader(buf)
    shader.data = buf
    shader.size = 3804
    return shader
